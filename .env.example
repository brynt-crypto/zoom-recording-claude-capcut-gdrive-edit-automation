# ---------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and fill in YOUR OWN values.
# `.env` is gitignored and never committed. Every var is optional — leave a
# line blank/removed to disable the feature that needs it.
# ---------------------------------------------------------------------------

# --- Google Drive pipeline (/scan, drive_sync) ------------------------------
# Full paths to your Google Drive for Desktop folders.
#   Windows example:  G:\My Drive\Zoom Recordings
#   macOS example:    /Users/you/Library/CloudStorage/GoogleDrive-you@example.com/My Drive/Zoom Recordings
DRIVE_INPUT_DIR=
DRIVE_EXPORT_DIR=
DRIVE_UPLOAD_DIR=
# Web URL of the upload folder (shown in the final report). Optional.
DRIVE_UPLOAD_FOLDER_URL=

# macOS convenience: instead of full DRIVE_* paths you can set the account email
# and just the folder names — the ~/Library/CloudStorage mount is derived.
GDRIVE_EMAIL=
DRIVE_INPUT_FOLDER_NAME=
DRIVE_UPLOAD_FOLDER_NAME=

# --- Rough-cut source scan (/roughcut) --------------------------------------
# Extra folders to scan for source videos, os.pathsep-separated
# (';' on Windows, ':' on macOS/Linux). Defaults to ~/Videos + ~/Downloads
# (Windows) or ~/Movies + ~/Downloads (macOS/Linux) when unset.
ROUGHCUT_SCAN_DIRS=

# --- Animate feature (/animate, Google Imagen) ------------------------------
# Get a key at https://aistudio.google.com/apikey  (only needed for --provider imagen)
GEMINI_API_KEY=

# --- On-screen host name (CFE lower thirds) ---------------------------------
# The only name allowed on screen in a lower third. Comma-separated if the host
# goes by more than one form (e.g. Jordan,Jo). Leave blank to forbid all names.
HOST_NAMES=

# --- Where the big things live (see common/paths.py) ------------------------
# Source video, per-job working files and exports are large and disposable.
# Point these outside the project — and off any synced drive (OneDrive/iCloud
# dehydrate files into placeholders whose reads hang forever). Unset = inside
# the project, as before.
MEDIA_ROOT=
JOBS_DIR=
OUTPUT_DIR=
WORK_DIR=
